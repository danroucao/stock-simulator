{
  "name": "stock",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "worker:dev": "wrangler dev --config worker/wrangler.jsonc --port 8787",
    "worker:check": "wrangler deploy --config worker/wrangler.jsonc --dry-run",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "verify:trading": "node scripts/verify-trading-flow.mjs",
    "verify:tabs": "node scripts/verify-storage-tabs.mjs",
    "verify:ui": "node scripts/verify-ui.mjs",
    "verify:mobile": "node scripts/verify-trading-flow.mjs --mobile && node scripts/verify-edge-flows.mjs",
    "verify:density": "node scripts/verify-workspace-density.mjs",
    "verify:alerts": "node scripts/verify-alert-center.mjs",
    "verify:scan": "node scripts/verify-scan-pipeline.mjs",
    "scan:market": "node scripts/scan-market.mjs"
  },
  "private": true,
  "packageManager": "npm@11.18.0",
  "dependencies": {
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@angular/router": "^22.0.0",
    "exceljs": "^4.4.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.0.5",
    "@angular/cli": "^22.0.5",
    "@angular/compiler-cli": "^22.0.0",
    "@vitest/browser-playwright": "^4.1.10",
    "jsdom": "^28.0.0",
    "playwright": "^1.62.1",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8",
    "wrangler": "^4.148.0"
  }
}
